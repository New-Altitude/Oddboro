diff --git a/internal/embedded/embedded.go b/internal/embedded/embedded.go
new file mode 100644
index 0000000000000000000000000000000000000000..fc1346654013ba10749392c38d765a20eb660b5c
--- /dev/null
+++ b/internal/embedded/embedded.go
@@ -0,0 +1,33 @@
+// Package embedded holds the process-wide managed-runtime boundary.
+package embedded
+
+import "os"
+
+// Enabled is set before startup, only for an explicitly requested web runtime.
+var Enabled bool
+
+// DataDir is the absolute directory holding this runtime's state.
+var DataDir string
+
+// AccountsOff records the user's inherited privacy choice before embedded mode suppresses legacy discovery.
+var AccountsOff bool
+
+// Identity binds both listeners to the host's per-process nonce.
+type Identity struct {
+	App          string   `json:"app"`
+	APIVersion   int      `json:"apiVersion"`
+	Embedded     bool     `json:"embedded"`
+	Version      string   `json:"version"`
+	InstanceID   string   `json:"instanceId,omitempty"`
+	Capabilities []string `json:"capabilities"`
+}
+
+// Integration describes the supported management contract.
+func Integration(version string) Identity {
+	id := Identity{App: "magpie", APIVersion: 1, Embedded: Enabled, Version: version, Capabilities: []string{"providers", "groups"}}
+	if Enabled {
+		id.Capabilities = append(id.Capabilities, "signin:codex", "discovery:codex-file")
+		id.InstanceID = os.Getenv("MAGPIE_EMBEDDED_INSTANCE_ID")
+	}
+	return id
+}
