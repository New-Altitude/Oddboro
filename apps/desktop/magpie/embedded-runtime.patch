+func TestEmbeddedRoutes(t *testing.T) {
+	h := embeddedRoutes(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusNoContent) }))
+	for _, tc := range []struct {
+		method, path string
+		want         int
+	}{
+		{"GET", "/", 204}, {"GET", "/api/integration", 204}, {"GET", "/api/providers", 204}, {"POST", "/api/provider/save", 204},
+		{"POST", "/api/groups/save", 204}, {"POST", "/api/signin", 204},
+		{"POST", "/api/provider/adopt", 404}, {"POST", "/api/agent/connect", 404}, {"POST", "/api/window/quit", 404},
+	} {
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, httptest.NewRequest(tc.method, tc.path, nil))
+		if w.Code != tc.want {
+			t.Errorf("%s %s: got %d, want %d", tc.method, tc.path, w.Code, tc.want)
+		}
+	}
+}
+
+// Provider and group changes must leave another agent's configuration alone.
+func TestEmbeddedProviderGroupPreservesAgentFiles(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	t.Setenv("MAGPIE_NO_ACCOUNTS", "1")
+	embedded.Enabled, embedded.DataDir = true, t.TempDir()
+	t.Cleanup(func() { agent.SyncCatalogSettled(); embedded.Enabled, embedded.DataDir = false, "" })
+	path := filepath.Join(home, ".codex", "config.toml")
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		t.Fatal(err)
+	}
+	const original = "model_provider = \"magpie\"\nmodel = \"relay/m\"\n"
+	if err := os.WriteFile(path, []byte(original), 0600); err != nil {
+		t.Fatal(err)
+	}
+	mux := http.NewServeMux()
+	providerRoutes(mux, webHost{func() {}})
+	h := embeddedRoutes(mux)
+	call := func(path, body string) {
+		t.Helper()
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, httptest.NewRequest("POST", path, strings.NewReader(body)))
+		if w.Code != http.StatusOK {
+			t.Fatalf("%s: %d %s", path, w.Code, w.Body.String())
+		}
+	}
+	call("/api/provider/save", `{"id":"relay","name":"Relay","chat":"http://127.0.0.1:1/v1","key":"fixture","models":["m"],"new":true}`)
+	call("/api/groups/save", `{"id":"first","name":"First","members":["relay/m"]}`)
+	call("/api/groups/save", `{"id":"second","from":"first","name":"Second","members":["relay/m"]}`)
+	call("/api/groups/delete", `{"id":"second"}`)
+	call("/api/provider/delete", `{"id":"relay"}`)
+	agent.SyncCatalogSettled()
+	b, err := os.ReadFile(path)
+	if err != nil || string(b) != original {
+		t.Fatalf("agent file changed: %q, %v", b, err)
+	}
+}
+
+func TestEmbeddedWebRejectsOccupiedGateway(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	t.Setenv("MAGPIE_NO_ACCOUNTS", "1")
+	t.Setenv("MAGPIE_WEB_KEY", "synthetic-management-key")
+	t.Setenv("MAGPIE_EMBEDDED_GATEWAY_KEY", "synthetic-gateway-key")
+	busy, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer busy.Close()
+	t.Setenv("MAGPIE_ADDR", busy.Addr().String())
+	embedded.Enabled, embedded.DataDir = true, t.TempDir()
+	t.Cleanup(func() { embedded.Enabled, embedded.DataDir = false, "" })
