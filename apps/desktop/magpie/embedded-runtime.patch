+func TestEmbeddedCodexConcurrentDirectoryReplacementStaysPrivate(t *testing.T) {
+	data, external := t.TempDir(), t.TempDir()
+	oldEnabled, oldData := embedded.Enabled, embedded.DataDir
+	embedded.Enabled, embedded.DataDir = true, data
+	t.Cleanup(func() { embedded.Enabled, embedded.DataDir = oldEnabled, oldData })
+	target := filepath.Join(external, "auth.json")
+	sentinel := []byte("unrelated credentials")
+	if err := os.WriteFile(target, sentinel, 0600); err != nil {
+		t.Fatal(err)
+	}
+	dir, parked := filepath.Join(data, "codex"), filepath.Join(data, "parked")
+	if err := os.Mkdir(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	probe := filepath.Join(data, "symlink-probe")
+	if err := os.Symlink(external, probe); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	if err := os.Remove(probe); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for i := 0; i < 300; i++ {
+			if os.Rename(dir, parked) != nil {
+				continue
+			}
+			if os.Symlink(external, dir) == nil {
+				_ = os.Remove(dir)
+			}
+			_ = os.Rename(parked, dir)
+		}
+	}()
+	for i := 0; i < 300; i++ {
+		_ = embeddedPrivateWrite(dir, "auth.json", []byte("private"))
+	}
+	<-done
+	got, err := os.ReadFile(target)
+	if err != nil || string(got) != string(sentinel) {
+		t.Fatalf("external credential changed under directory replacement: %v", err)
+	}
+}
