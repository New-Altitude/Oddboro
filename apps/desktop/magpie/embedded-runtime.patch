+
+func TestEmbeddedCodexSourceSelectionDoesNotCopyCredentials(t *testing.T) {
+	home, data := t.TempDir(), t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("MAGPIE_NO_ACCOUNTS", "1")
+	t.Setenv("CODEX_HOME", filepath.Join(home, ".codex"))
+	oldEnabled, oldData := embedded.Enabled, embedded.DataDir
+	embedded.Enabled, embedded.DataDir = true, data
+	t.Cleanup(func() { embedded.Enabled, embedded.DataDir = oldEnabled, oldData })
+	dir := filepath.Join(home, ".codex")
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "config.toml"), []byte("cli_auth_credentials_store = \"file\"\n[features]\nsecret_auth_storage = false\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	credential := []byte(`{"tokens":{"access_token":"synthetic-access","refresh_token":"synthetic-refresh","account_id":"synthetic-user"}}`)
+	if err := os.WriteFile(filepath.Join(dir, "auth.json"), credential, 0600); err != nil {
+		t.Fatal(err)
+	}
+	sources, err := DiscoverEmbeddedCodexSources()
+	if err != nil || len(sources) != 1 || sources[0].User != "synthetic-user" {
+		t.Fatalf("discovery: %+v, %v", sources, err)
+	}
+	if err := SelectEmbeddedCodexSource(sources[0].Ref); err != nil {
+		t.Fatal(err)
+	}
+	p, ok := embeddedCodexAccount()
+	if !ok {
+		t.Fatal("selected source was not available")
+	}
+	if ls := Logins("codex"); len(ls) != 1 || !ls[0].Own || ls[0].User != "synthetic-user" {
+		t.Fatalf("shared login metadata: %+v", ls)
+	}
+	req := httptest.NewRequest(http.MethodPost, "http://example.invalid/responses", nil)
+	if err := p.Sign(context.Background(), req, Responses, nil); err != nil {
+		t.Fatal(err)
+	}
+	if got := req.Header.Get("Authorization"); got != "Bearer synthetic-access" {
+		t.Fatalf("selected source authorization: %q", got)
+	}
+	b, err := os.ReadFile(filepath.Join(data, "codex-source.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), "synthetic-refresh") || strings.Contains(string(b), "synthetic-access") {
+		t.Fatal("credentials copied into source record")
+	}
+	got, err := os.ReadFile(filepath.Join(dir, "auth.json"))
+	if err != nil || string(got) != string(credential) {
+		t.Fatalf("discovery changed source: %v", err)
+	}
+	if err := SelectEmbeddedCodexSource(filepath.Join(home, "unlisted")); err == nil {
+		t.Fatal("selected an undiscovered source")
+	}
+	expired := fmt.Sprintf(`{"tokens":{"access_token":%q,"refresh_token":"synthetic-refresh","account_id":"synthetic-user"}}`, embeddedTestToken(time.Now().Add(-time.Hour).Unix()))
+	if err := os.WriteFile(filepath.Join(dir, "auth.json"), []byte(expired), 0600); err != nil {
+		t.Fatal(err)
+	}
+	req = httptest.NewRequest(http.MethodPost, "http://example.invalid/responses", nil)
+	if err := p.Sign(context.Background(), req, Responses, nil); err == nil || !strings.Contains(err.Error(), "renewal in Codex") {
+		t.Fatalf("expired shared source: %v", err)
+	}
+	after, err := os.ReadFile(filepath.Join(dir, "auth.json"))
+	if err != nil || string(after) != expired {
+		t.Fatalf("expired shared source changed: %v", err)
+	}
+}
