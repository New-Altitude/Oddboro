+++ b/internal/gateway/embedded_test.go
@@ -0,0 +1,75 @@
+package gateway
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/yetone/magpie/internal/embedded"
+)
+
+func TestEmbeddedGatewayRequiresKey(t *testing.T) {
+	embedded.Enabled = true
+	t.Cleanup(func() { embedded.Enabled = false })
+	t.Setenv("MAGPIE_EMBEDDED_GATEWAY_KEY", "a-long-synthetic-key")
+	h := lanGuard(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusNoContent) }))
+	for _, tc := range []struct {
+		key  string
+		want int
+	}{{"", 401}, {"wrong", 401}, {"a-long-synthetic-key", 204}} {
