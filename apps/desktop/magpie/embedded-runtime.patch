+// embeddedFront exposes inference only to a managed host's gateway key.
+func embeddedFront(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		p := r.URL.Path
+		allowed := false
+		if r.Method == http.MethodGet {
+			allowed = p == "/v1/magpie/integration" || p == "/v1/responses" || p == "/v1/models"
+			if id, ok := strings.CutPrefix(p, "/v1/models/"); ok && id != "" && !strings.Contains(id, "/") {
+				allowed = true
+			}
+		}
+		if r.Method == http.MethodPost {
+			switch p {
+			case "/v1/chat/completions", "/v1/responses", "/v1/messages", "/v1/messages/count_tokens":
+				allowed = true
+			}
+		}
+		if !allowed || path.Clean(p) != p {
+			http.NotFound(w, r)
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
+}
