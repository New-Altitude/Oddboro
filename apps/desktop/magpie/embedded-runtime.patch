diff --git a/internal/provider/embedded_codex.go b/internal/provider/embedded_codex.go
new file mode 100644
index 0000000000000000000000000000000000000000..f66c4892af943baacd894bf1132719132d85f643
--- /dev/null
+++ b/internal/provider/embedded_codex.go
@@ -0,0 +1,259 @@
+package provider
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/yetone/magpie/internal/appdir"
+	"github.com/yetone/magpie/internal/catalog"
+	"github.com/yetone/magpie/internal/codexcat"
+	"github.com/yetone/magpie/internal/embedded"
+)
+
+var embeddedCodexMu sync.Mutex
+
+// The opened root confines private operations even if another process moves
+// or replaces a directory after the check. Temp files are renamed within it.
+func embeddedPrivateWrite(dir, name string, b []byte) error {
+	if err := os.MkdirAll(embedded.DataDir, 0700); err != nil {
+		return err
+	}
+	root, err := os.OpenRoot(embedded.DataDir)
+	if err != nil {
+		return err
+	}
+	defer root.Close()
+	rel := name
+	if dir != embedded.DataDir {
+		if dir != appdir.EmbeddedCodexHome() || name != "auth.json" {
+			return errors.New("invalid private Codex path")
+		}
+		if err := root.Mkdir("codex", 0700); err != nil && !errors.Is(err, os.ErrExist) {
+			return err
+		}
+		info, err := root.Lstat("codex")
+		if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			return errors.New("private Codex directory is unavailable or symlinked")
+		}
+		rel = filepath.Join("codex", name)
+	} else if name != "codex-source.json" {
+		return errors.New("invalid private Codex path")
+	}
+	info, err := root.Lstat(rel)
+	if err == nil && !info.Mode().IsRegular() {
+		return errors.New("private Codex file is not a regular file")
+	}
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	tmp := filepath.Join(filepath.Dir(rel), "."+name+"."+randomToken(12))
+	f, err := root.OpenFile(tmp, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return err
+	}
+	_, err = f.Write(b)
+	if err == nil {
+		err = f.Sync()
+	}
+	if closeErr := f.Close(); err == nil {
+		err = closeErr
+	}
+	if err == nil {
+		err = root.Rename(tmp, rel)
+	}
+	if err != nil {
+		_ = root.Remove(tmp)
+	}
+	return err
+}
+
+func embeddedPrivateRead(path string) ([]byte, error) {
+	root, err := os.OpenRoot(embedded.DataDir)
+	if err != nil {
+		return nil, err
+	}
+	defer root.Close()
+	var rel string
+	switch path {
+	case filepath.Join(embedded.DataDir, "codex-source.json"):
+		rel = "codex-source.json"
+	case filepath.Join(appdir.EmbeddedCodexHome(), "auth.json"):
+		info, err := root.Lstat("codex")
+		if err != nil {
+			return nil, err
+		}
+		if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			return nil, errors.New("private Codex directory is unavailable or symlinked")
+		}
+		rel = filepath.Join("codex", "auth.json")
+	default:
+		return nil, errors.New("invalid private Codex path")
+	}
+	info, err := root.Lstat(rel)
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() {
+		return nil, errors.New("private Codex file is not a regular file")
+	}
+	return root.ReadFile(rel)
+}
+
+func embeddedRemoveSelection() error {
+	root, err := os.OpenRoot(embedded.DataDir)
+	if err != nil {
+		return err
+	}
+	defer root.Close()
+	err = root.Remove("codex-source.json")
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	return err
+}
+
+// embeddedCodexSource returns the selected shared source, or the private
+// owned store if no shared source was selected. Invalid selection fails closed.
+func embeddedCodexSource() (string, bool, error) {
+	b, err := embeddedPrivateRead(filepath.Join(embedded.DataDir, "codex-source.json"))
+	if errors.Is(err, os.ErrNotExist) {
+		return appdir.EmbeddedCodexHome(), false, nil
+	}
+	if err != nil {
+		return "", false, err
+	}
+	var s EmbeddedCodexSource
+	if json.Unmarshal(b, &s) != nil || s.Source != "codex-file" || !filepath.IsAbs(s.Ref) {
+		return "", false, errors.New("invalid selected Codex source")
+	}
+	return s.Ref, true, nil
+}
+
+func embeddedCodexRead(dir string, shared bool) ([]byte, error) {
+	if shared {
+		b, canonical, err := embeddedCodexFile(dir)
+		if err != nil {
+			return nil, err
+		}
+		if canonical != dir {
+			return nil, errors.New("selected Codex source changed")
+		}
+		return b, nil
+	}
+	return embeddedPrivateRead(filepath.Join(dir, "auth.json"))
+}
+
+func embeddedCodexToken(ctx context.Context, dir string, shared bool, stale string) (string, string, error) {
+	embeddedCodexMu.Lock()
+	defer embeddedCodexMu.Unlock()
+	if err := embeddedAccountsAllowed(); err != nil {
+		return "", "", err
+	}
+	selected, isShared, err := embeddedCodexSource()
+	if err != nil || selected != dir || isShared != shared {
+		return "", "", errors.New("selected Codex account changed")
+	}
+	b, err := embeddedCodexRead(dir, shared)
+	var a codexAuth
+	if err != nil || json.Unmarshal(b, &a) != nil || a.Tokens.AccessToken == "" {
+		return "", "", errors.New("Codex sign-in is unavailable")
+	}
+	exp, _ := jwtClaims(a.Tokens.AccessToken)["exp"].(float64)
+	if stale == "" && (exp == 0 || time.Until(time.Unix(int64(exp), 0)) > 5*time.Minute) || stale != "" && stale != a.Tokens.AccessToken {
+		return a.Tokens.AccessToken, codexAccountID(a), nil
+	}
+	if shared {
+		return "", "", errors.New("shared Codex sign-in needs renewal in Codex")
+	}
+	var raw map[string]any
+	if json.Unmarshal(b, &raw) != nil {
+		return "", "", errors.New("invalid Codex sign-in")
+	}
+	reason := codexRefreshExpiry
+	if stale != "" {
+		reason = codexRefreshRecovery
+	}
+	token, err := codexRefresh(ctx, raw, reason)
+	if err != nil {
+		return "", "", err
+	}
+	fresh, err := json.MarshalIndent(raw, "", "  ")
+	if err != nil {
+		return "", "", err
+	}
+	if err := embeddedPrivateWrite(dir, "auth.json", append(fresh, '\n')); err != nil {
+		return "", "", fmt.Errorf("could not save rotated Codex token: %w", err)
+	}
+	return token, codexAccountID(a), nil
+}
+
+func addEmbeddedCodexLogin(l savedLogin) (bool, error) {
+	if err := embeddedAccountsAllowed(); err != nil {
+		return false, err
+	}
+	if l.Agent != "codex" {
+		return false, errors.New("unsupported embedded sign-in")
+	}
+	embeddedCodexMu.Lock()
+	defer embeddedCodexMu.Unlock()
+	if err := embeddedPrivateWrite(appdir.EmbeddedCodexHome(), "auth.json", append(l.Auth, '\n')); err != nil {
+		return false, err
+	}
+	if err := embeddedRemoveSelection(); err != nil {
+		return false, err
+	}
+	Changed()
+	return true, nil
+}
+
+func embeddedCodexAccount() (Provider, bool) {
+	if embeddedAccountsAllowed() != nil {
+		return Provider{}, false
+	}
+	dir, shared, err := embeddedCodexSource()
+	if err != nil {
+		return Provider{}, false
+	}
+	b, err := embeddedCodexRead(dir, shared)
+	var a codexAuth
+	if err != nil || json.Unmarshal(b, &a) != nil || a.AuthMode == "apikey" || a.Tokens.AccessToken == "" {
+		return Provider{}, false
+	}
+	claims := jwtClaims(a.Tokens.IDToken)
+	user := codexUser(claims)
+	if user == "" {
+		user = a.Tokens.AccountID
+	}
+	if user == "" {
+		user = "ChatGPT"
+	}
+	cacheID := accountModels("codex", user+"\x00"+a.Tokens.AccountID+"\x00"+dir)
+	acct := &Account{Agent: "codex", User: user, Plan: claimString(claims, "https://api.openai.com/auth", "chatgpt_plan_type"), Stream: true, embeddedCodex: true, modelsCacheID: cacheID, models: func() []catalog.Model { ms, _, _ := catalog.Live(cacheID); return ms }, listedOnly: true}
+	promptsPath := catalog.LivePath(cacheID) + ".prompts"
+	acct.body = func(body []byte) []byte {
+		return codexBodyUsing(body, func(model string) string {
+			if s, ok := savedPrompts.get(promptsPath, model, func(b []byte) map[string]string { var m map[string]string; _ = json.Unmarshal(b, &m); return m }); ok {
+				return s
+			}
+			return codexcat.Official(model)
+		})
+	}
+	acct.sign = codexSign(func(ctx context.Context) (string, string, error) { return embeddedCodexToken(ctx, dir, shared, "") })
+	acct.renew = func(ctx context.Context, stale string) (string, string, error) {
+		return embeddedCodexToken(ctx, dir, shared, stale)
+	}
+	acct.fetch = func(ctx context.Context) ([]catalog.Model, error) {
+		ms, err := codexModelsWithPrompts(ctx, acct.sign, func(b []byte) { saveCodexPromptsAt(promptsPath, b) })
+		if err != nil {
+			return nil, err
+		}
+		return ms, catalog.SaveLive(cacheID, CodexBase, ms)
+	}
+	return Provider{ID: "codex", Name: "Codex", Icon: "codex-color", Responses: CodexBase, Website: "https://chatgpt.com/codex", Account: acct}, true
+}
diff --git a/internal/provider/embedded_codex_sources.go b/internal/provider/embedded_codex_sources.go
new file mode 100644
index 0000000000000000000000000000000000000000..26b7ea3df01a4f35f01081ea2e675558ffa05aa7
--- /dev/null
+++ b/internal/provider/embedded_codex_sources.go
@@ -0,0 +1,117 @@
+package provider
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/yetone/magpie/internal/appdir"
+	"github.com/yetone/magpie/internal/embedded"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+func embeddedAccountsAllowed() error {
+	if !embedded.Enabled {
+		return errors.New("embedded mode is required")
+	}
+	if embedded.AccountsOff {
+		return errAccountDiscoveryOff
+	}
+	s, err := settings.LoadChecked()
+	if err != nil {
+		return fmt.Errorf("account privacy setting unavailable: %w", err)
+	}
+	if s.NoAccountDiscovery {
+		return errAccountDiscoveryOff
+	}
+	return nil
+}
+
+// EmbeddedCodexSource describes a discovered file-backed Codex sign-in.
+// Ref is its canonical home, never a credential. Discovering sources reads
+// local credentials and must only be called in response to an explicit request.
+type EmbeddedCodexSource struct {
+	Source string `json:"source"`
+	Ref    string `json:"ref"`
+	User   string `json:"user"`
+	Plan   string `json:"plan,omitempty"`
+}
+
+func embeddedCodexFile(home string) ([]byte, string, error) {
+	home, err := filepath.EvalSymlinks(home)
+	if err != nil || !filepath.IsAbs(home) {
+		return nil, "", errors.New("Codex source is not an existing absolute directory")
+	}
+	cfg, err := readCodexStoreSetting(home)
+	if err != nil || cfg.Mode != "file" || cfg.Secrets {
+		return nil, "", errors.New("Codex source does not use a supported file credential store")
+	}
+	path := filepath.Join(home, "auth.json")
+	info, err := os.Lstat(path)
+	if err != nil || !info.Mode().IsRegular() {
+		return nil, "", errors.New("Codex credential file is unavailable or is a symlink")
+	}
+	b, err := os.ReadFile(path)
+	return b, home, err
+}
+
+// DiscoverEmbeddedCodexSources reads only file-backed Codex homes and returns
+// metadata without tokens. It is never run during startup or ordinary listing.
+func DiscoverEmbeddedCodexSources() ([]EmbeddedCodexSource, error) {
+	if err := embeddedAccountsAllowed(); err != nil {
+		return nil, err
+	}
+	out := []EmbeddedCodexSource{}
+	seen := map[string]bool{}
+	for _, dir := range appdir.CodexHomes() {
+		b, home, err := embeddedCodexFile(dir)
+		if err != nil || seen[home] {
+			continue
+		}
+		var auth codexAuth
+		if json.Unmarshal(b, &auth) != nil || auth.AuthMode == "apikey" || auth.Tokens.AccessToken == "" {
+			continue
+		}
+		claims := jwtClaims(auth.Tokens.IDToken)
+		user := codexUser(claims)
+		if user == "" {
+			user = auth.Tokens.AccountID
+		}
+		if user == "" {
+			continue
+		}
+		seen[home] = true
+		out = append(out, EmbeddedCodexSource{Source: "codex-file", Ref: home, User: user, Plan: claimString(claims, "https://api.openai.com/auth", "chatgpt_plan_type")})
+	}
+	return out, nil
+}
+
+// SelectEmbeddedCodexSource records a reference, not a copy of the tokens.
+// The caller must first obtain consent to read this shared sign-in. Magpie
+// never refreshes or writes it; Codex must renew an expired token. Only a
+// source returned by a fresh discovery can be selected.
+func SelectEmbeddedCodexSource(ref string) error {
+	if !embedded.Enabled {
+		return errors.New("embedded mode is required")
+	}
+	sources, err := DiscoverEmbeddedCodexSources()
+	if err != nil {
+		return err
+	}
+	for _, source := range sources {
+		if source.Ref == ref {
+			b, err := json.Marshal(source)
+			if err != nil {
+				return err
+			}
+			if err := embeddedPrivateWrite(embedded.DataDir, "codex-source.json", append(b, '\n')); err != nil {
+				return err
+			}
+			Changed()
+			return nil
+		}
+	}
+	return fmt.Errorf("Codex source was not found in the current discovery")
+}
