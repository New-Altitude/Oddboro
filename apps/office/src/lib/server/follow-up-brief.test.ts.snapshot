exports[`task_done keeps the words its run receives 1`] = `
[
  "{owner} finished the task you gave them: \\"Sign in\\". Pick up the work that waited on it now.",
  "",
  "- Why you gave it: Needed",
  "- Their note: Their words",
  "",
